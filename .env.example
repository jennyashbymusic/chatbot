# --- Twilio (or swap for Telnyx equivalents) ---
# Account SID: Console dashboard "Account Info" panel (starts with AC).
# Required regardless of which auth style below you use.
TWILIO_ACCOUNT_SID=
# Auth Token: same "Account Info" panel (click "Show" to reveal). Used ONLY to
# verify inbound webhook signatures — Twilio signs webhooks with this specific
# token, an API Key Secret cannot substitute for it. Required even if you use
# an API Key for the two vars below.
TWILIO_AUTH_TOKEN=
# Optional: authenticate outbound sends with an API Key (starts with SK) +
# Secret instead of the Auth Token above (Twilio's recommended pattern, since
# it can be revoked independently). Leave blank to fall back to
# TWILIO_AUTH_TOKEN for sending too.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- SMS provider ("twilio" or "telnyx") ---
# Selects which provider actually sends/receives Jenny's texts — see
# src/messaging/index.ts. Defaults to "twilio" if unset.
MESSAGING_PROVIDER=twilio

# --- Telnyx (alternative SMS provider) ---
# API key: Mission Control -> Account Settings -> Auth -> API Keys
TELNYX_API_KEY=
# The Telnyx number you're sending from (E.164 format, e.g. +15551234567)
TELNYX_PHONE_NUMBER=
# Base64 Ed25519 public key: Mission Control -> Account Settings -> Keys & Credentials
# Used to verify inbound webhook signatures — see src/messaging/telnyx.ts
TELNYX_PUBLIC_KEY=

# --- LLM provider ("anthropic" or "gemini") ---
# Selects which model powers Jenny's replies — see src/llm/index.ts. Defaults
# to "anthropic" if unset. Only the corresponding API key below is needed.
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Gemini (Google AI Studio) ---
# Free-tier API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI (moderation only) ---
OPENAI_API_KEY=

# --- ElevenLabs (voice tier) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_VOICE=

# --- Crisis alerting ---
# Slack incoming webhook URL (or swap for email/SMS) used to alert a human when
# a message is flagged by the moderation layer.
CRISIS_ALERT_WEBHOOK_URL=

# --- Server ---
PORT=3000
