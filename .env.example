# --- Twilio (or swap for Telnyx equivalents) ---
# Account SID: Console dashboard "Account Info" panel (starts with AC).
# Required regardless of which auth style below you use.
TWILIO_ACCOUNT_SID=
# Auth Token: same "Account Info" panel (click "Show" to reveal). Used ONLY to
# verify inbound webhook signatures — Twilio signs webhooks with this specific
# token, an API Key Secret cannot substitute for it. Required even if you use
# an API Key for the two vars below.
TWILIO_AUTH_TOKEN=
# Optional: authenticate outbound sends with an API Key (starts with SK) +
# Secret instead of the Auth Token above (Twilio's recommended pattern, since
# it can be revoked independently). Leave blank to fall back to
# TWILIO_AUTH_TOKEN for sending too.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI (moderation only) ---
OPENAI_API_KEY=

# --- ElevenLabs (voice tier) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_VOICE=

# --- Crisis alerting ---
# Slack incoming webhook URL (or swap for email/SMS) used to alert a human when
# a message is flagged by the moderation layer.
CRISIS_ALERT_WEBHOOK_URL=

# --- Server ---
PORT=3000
